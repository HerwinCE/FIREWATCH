{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd firewatch-africa && npm ci",
  "buildCommand": "cd firewatch-africa && npm run build",
  "outputDirectory": "firewatch-africa/dist",
  "regions": ["fra1"],
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/app/**,data/boundaries/**}",
      "excludeFiles": "{backend/.venv/**,backend/tests/**,firewatch-africa/**,data/raw/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ]
}

{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "FireWatch Africa — design tokens v1.0 (format W3C DTCG). Source unique : tokens.css, tokens.ts et tailwind.preset.js sont générés à partir de ce fichier (scripts/build-tokens.mjs).",
  "color": {
    "dark": {
      "bg": {
        "base":     { "$type": "color", "$value": "#0A0F15", "$description": "Fond principal noir bleuté" },
        "sunken":   { "$type": "color", "$value": "#070B10", "$description": "Fond de carte, zones encastrées" },
        "surface1": { "$type": "color", "$value": "#111922", "$description": "Cartes, panneaux" },
        "surface2": { "$type": "color", "$value": "#17212C", "$description": "Survol, en-têtes de tableau, champs" },
        "surface3": { "$type": "color", "$value": "#1E2A37", "$description": "Éléments actifs, chips sélectionnées" },
        "overlay":  { "$type": "color", "$value": "rgba(5,8,12,0.72)", "$description": "Voile derrière tiroirs et modales" }
      },
      "border": {
        "subtle":  { "$type": "color", "$value": "#1F2B38" },
        "default": { "$type": "color", "$value": "#2A3A4B" },
        "strong":  { "$type": "color", "$value": "#3B5068" },
        "focus":   { "$type": "color", "$value": "#4CC9F0", "$description": "Anneau de focus clavier (cyan NASA), 2 px + offset 2 px" }
      },
      "text": {
        "primary":   { "$type": "color", "$value": "#ECE7DE", "$description": "Blanc cassé — 15.6:1 sur bg.base" },
        "secondary": { "$type": "color", "$value": "#9DACBD", "$description": "Gris bleuté — 8.3:1 sur bg.base" },
        "muted":     { "$type": "color", "$value": "#8193A5", "$description": "Légendes, métadonnées — ≥ 4.6:1 jusqu'à surface2" },
        "inverse":   { "$type": "color", "$value": "#0A0F15" }
      },
      "thermal": {
        "100": { "$type": "color", "$value": "#FFE3C2" },
        "300": { "$type": "color", "$value": "#FFB067", "$description": "Détections de faible FRP" },
        "500": { "$type": "color", "$value": "#F28C28", "$description": "Orange thermique — couleur des détections" },
        "700": { "$type": "color", "$value": "#C2621A" },
        "glow": { "$type": "color", "$value": "rgba(242,140,40,0.35)" }
      },
      "high": {
        "500": { "$type": "color", "$value": "#F0585D", "$description": "Rouge — réservé au niveau ÉLEVÉ, toujours accompagné d'une icône ▲ et d'un libellé" },
        "bg":  { "$type": "color", "$value": "rgba(240,88,93,0.14)" }
      },
      "forest": {
        "300": { "$type": "color", "$value": "#6CC79A" },
        "500": { "$type": "color", "$value": "#2F8F62", "$description": "Vert forêt — environnement, état sain (non textuel sous 4.5:1)" },
        "700": { "$type": "color", "$value": "#1B5A3E" },
        "900": { "$type": "color", "$value": "#0F2A1F", "$description": "Masse forestière sur les cartes" }
      },
      "nasa": {
        "300": { "$type": "color", "$value": "#8FDDF6" },
        "500": { "$type": "color", "$value": "#4CC9F0", "$description": "Cyan — données NASA, éléments techniques, liens, focus" },
        "bg":  { "$type": "color", "$value": "rgba(76,201,240,0.12)" }
      },
      "sensor": {
        "modis": { "$type": "color", "$value": "#C2851F", "$description": "MODIS — ambre, marqueur CARRÉ (paire validée CVD ΔE 21 avec VIIRS)" },
        "viirs": { "$type": "color", "$value": "#2E97C6", "$description": "VIIRS — bleu-cyan, marqueur ROND" },
        "fused": { "$type": "color", "$value": "#B39DFA", "$description": "Événement harmonisé — violet, marqueur LOSANGE" }
      },
      "level": {
        "low":      { "$type": "color", "$value": "#6CC79A", "$description": "Faible — icône ▽" },
        "moderate": { "$type": "color", "$value": "#F2B53A", "$description": "Modéré — icône ◆" },
        "high":     { "$type": "color", "$value": "#F0585D", "$description": "Élevé — icône ▲" }
      },
      "feedback": {
        "info":    { "$type": "color", "$value": "#4CC9F0" },
        "success": { "$type": "color", "$value": "#6CC79A" },
        "warning": { "$type": "color", "$value": "#F2B53A" },
        "danger":  { "$type": "color", "$value": "#F0585D" }
      },
      "map": {
        "ocean":     { "$type": "color", "$value": "#070B10" },
        "land":      { "$type": "color", "$value": "#141D27" },
        "landStroke":{ "$type": "color", "$value": "#273546" },
        "focusLand": { "$type": "color", "$value": "#16261F", "$description": "Afrique / Gabon mis en avant (teinte forêt)" },
        "graticule": { "$type": "color", "$value": "rgba(157,172,189,0.07)" },
        "admin":     { "$type": "color", "$value": "#3B5068" }
      },
      "chart": {
        "grid": { "$type": "color", "$value": "rgba(157,172,189,0.10)" },
        "axis": { "$type": "color", "$value": "#8193A5" },
        "seq1": { "$type": "color", "$value": "#2A1A0E" },
        "seq2": { "$type": "color", "$value": "#6B3412" },
        "seq3": { "$type": "color", "$value": "#B4561A" },
        "seq4": { "$type": "color", "$value": "#F28C28" },
        "seq5": { "$type": "color", "$value": "#FFC98A" }
      }
    },
    "light": {
      "bg": {
        "base":     { "$type": "color", "$value": "#F5F2EC" },
        "sunken":   { "$type": "color", "$value": "#E9E5DD" },
        "surface1": { "$type": "color", "$value": "#FFFFFF" },
        "surface2": { "$type": "color", "$value": "#F1EEE8" },
        "surface3": { "$type": "color", "$value": "#E6E2DA" },
        "overlay":  { "$type": "color", "$value": "rgba(20,32,43,0.45)" }
      },
      "border": {
        "subtle":  { "$type": "color", "$value": "#E2DDD3" },
        "default": { "$type": "color", "$value": "#CFC8BC" },
        "strong":  { "$type": "color", "$value": "#A69E90" },
        "focus":   { "$type": "color", "$value": "#0B6E99" }
      },
      "text": {
        "primary":   { "$type": "color", "$value": "#14202B" },
        "secondary": { "$type": "color", "$value": "#4A5A6A" },
        "muted":     { "$type": "color", "$value": "#5E6B78" },
        "inverse":   { "$type": "color", "$value": "#FFFFFF" }
      },
      "thermal": { "300": { "$type": "color", "$value": "#E0882F" }, "500": { "$type": "color", "$value": "#A04B06" }, "700": { "$type": "color", "$value": "#7A3904" } },
      "high":    { "500": { "$type": "color", "$value": "#B4232A" }, "bg": { "$type": "color", "$value": "rgba(180,35,42,0.10)" } },
      "forest":  { "300": { "$type": "color", "$value": "#1E6B47" }, "500": { "$type": "color", "$value": "#1E6B47" }, "900": { "$type": "color", "$value": "#DCEBE1" } },
      "nasa":    { "300": { "$type": "color", "$value": "#0B6E99" }, "500": { "$type": "color", "$value": "#0B6E99" }, "bg": { "$type": "color", "$value": "rgba(11,110,153,0.10)" } },
      "level":   { "low": { "$type": "color", "$value": "#1E6B47" }, "moderate": { "$type": "color", "$value": "#8A5A00" }, "high": { "$type": "color", "$value": "#B4232A" } },
      "feedback":{ "info": { "$type": "color", "$value": "#0B6E99" }, "success": { "$type": "color", "$value": "#1E6B47" }, "warning": { "$type": "color", "$value": "#8A5A00" }, "danger": { "$type": "color", "$value": "#B4232A" } },
      "chart":   { "grid": { "$type": "color", "$value": "rgba(20,32,43,0.08)" }, "axis": { "$type": "color", "$value": "#5E6B78" } },
      "sensor":  { "modis": { "$type": "color", "$value": "#9A6A00" }, "viirs": { "$type": "color", "$value": "#0B6E99" }, "fused": { "$type": "color", "$value": "#6145C9" } },
      "map":     { "ocean": { "$type": "color", "$value": "#DCE3E8" }, "land": { "$type": "color", "$value": "#F7F5F0" }, "landStroke": { "$type": "color", "$value": "#C3BCB0" }, "focusLand": { "$type": "color", "$value": "#E4EEE6" }, "graticule": { "$type": "color", "$value": "rgba(20,32,43,0.06)" }, "admin": { "$type": "color", "$value": "#A69E90" } }
    }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Inter", "Inter Variable", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "IBM Plex Mono", "ui-monospace", "SFMono-Regular", "DejaVu Sans Mono", "monospace"], "$description": "Coordonnées, horodatages, identifiants, valeurs numériques" }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "2xs": { "$type": "dimension", "$value": "11px", "$description": "Uniquement libellés en capitales espacées (overline)" },
      "xs":  { "$type": "dimension", "$value": "12px" },
      "sm":  { "$type": "dimension", "$value": "13px" },
      "md":  { "$type": "dimension", "$value": "14px", "$description": "Corps de texte de l'interface" },
      "lg":  { "$type": "dimension", "$value": "16px" },
      "xl":  { "$type": "dimension", "$value": "18px" },
      "2xl": { "$type": "dimension", "$value": "22px" },
      "3xl": { "$type": "dimension", "$value": "28px" },
      "4xl": { "$type": "dimension", "$value": "36px", "$description": "Chiffres clés (StatCard)" },
      "5xl": { "$type": "dimension", "$value": "48px" }
    },
    "lineHeight": {
      "tight":  { "$type": "number", "$value": 1.15 },
      "snug":   { "$type": "number", "$value": 1.3 },
      "normal": { "$type": "number", "$value": 1.5 },
      "relaxed":{ "$type": "number", "$value": 1.65 }
    },
    "letterSpacing": {
      "tight":    { "$type": "dimension", "$value": "-0.02em" },
      "normal":   { "$type": "dimension", "$value": "0" },
      "overline": { "$type": "dimension", "$value": "0.12em" }
    }
  },
  "space": {
    "0":  { "$type": "dimension", "$value": "0px" },
    "1":  { "$type": "dimension", "$value": "4px" },
    "2":  { "$type": "dimension", "$value": "8px" },
    "3":  { "$type": "dimension", "$value": "12px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "5":  { "$type": "dimension", "$value": "20px" },
    "6":  { "$type": "dimension", "$value": "24px" },
    "8":  { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "xs":   { "$type": "dimension", "$value": "4px" },
    "sm":   { "$type": "dimension", "$value": "6px" },
    "md":   { "$type": "dimension", "$value": "10px" },
    "lg":   { "$type": "dimension", "$value": "14px" },
    "full": { "$type": "dimension", "$value": "999px" }
  },
  "shadow": {
    "1": { "$type": "shadow", "$value": "0 1px 0 rgba(255,255,255,0.03) inset, 0 1px 2px rgba(0,0,0,0.4)" },
    "2": { "$type": "shadow", "$value": "0 8px 24px rgba(0,0,0,0.45), 0 1px 0 rgba(255,255,255,0.04) inset" },
    "3": { "$type": "shadow", "$value": "0 24px 64px rgba(0,0,0,0.6)" }
  },
  "size": {
    "sidebar":          { "$type": "dimension", "$value": "248px" },
    "sidebarCollapsed": { "$type": "dimension", "$value": "68px" },
    "topbar":           { "$type": "dimension", "$value": "56px" },
    "bottomNav":        { "$type": "dimension", "$value": "64px" },
    "assistantPanel":   { "$type": "dimension", "$value": "400px" },
    "filterPanel":      { "$type": "dimension", "$value": "320px" },
    "touchTarget":      { "$type": "dimension", "$value": "44px", "$description": "Cible tactile minimale (mobile/tablette)" },
    "controlHeight":    { "$type": "dimension", "$value": "36px" },
    "contentMax":       { "$type": "dimension", "$value": "1600px" }
  },
  "breakpoint": {
    "mobile":  { "$type": "dimension", "$value": "390px" },
    "tablet":  { "$type": "dimension", "$value": "768px" },
    "laptop":  { "$type": "dimension", "$value": "1280px" },
    "desktop": { "$type": "dimension", "$value": "1440px" }
  },
  "motion": {
    "duration": {
      "instant": { "$type": "duration", "$value": "80ms" },
      "fast":    { "$type": "duration", "$value": "140ms", "$description": "Survol, focus, bascules" },
      "base":    { "$type": "duration", "$value": "220ms", "$description": "Tiroirs, panneaux, changement de période" },
      "slow":    { "$type": "duration", "$value": "420ms", "$description": "Apparition progressive des données" },
      "pulse":   { "$type": "duration", "$value": "2400ms", "$description": "Pulsation des détections < 24 h" }
    },
    "easing": {
      "standard":   { "$type": "cubicBezier", "$value": [0.2, 0.7, 0.2, 1] },
      "emphasized": { "$type": "cubicBezier", "$value": [0.3, 0, 0, 1] },
      "exit":       { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1] }
    }
  },
  "z": {
    "map":      { "$type": "number", "$value": 0 },
    "sticky":   { "$type": "number", "$value": 10 },
    "sidebar":  { "$type": "number", "$value": 30 },
    "drawer":   { "$type": "number", "$value": 40 },
    "fab":      { "$type": "number", "$value": 45 },
    "modal":    { "$type": "number", "$value": 50 },
    "toast":    { "$type": "number", "$value": 60 }
  }
}
